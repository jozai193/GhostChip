    {
      "ref": {
        "kind": "field",
        "register": "chip_id",
        "field": "value"
      },
      "value": 88,
      "basis": "Explicit wrong-identity stimulus"
    }
  ],
  "required_observations": [
    "api.init",
    "interface.result"
  ],
  "assertions": [
    {
