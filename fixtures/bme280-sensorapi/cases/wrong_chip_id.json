    },
    {
      "id": "callback_succeeded",
      "source": "observation",
      "observation": "interface.result",
      "equals": 0,
      "basis": "Identity mismatch is not a bus error"
    }
  ],
  "expected_callbacks": [
    {
      "operation": "read",
      "register_address": 208,
      "length": 1,
      "status": 0
    }
  ],
  "expected_faults": []
}
