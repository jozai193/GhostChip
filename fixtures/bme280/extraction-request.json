  "device_name": "BME280 automatically extracted configuration slice",
  "vendor": "Bosch Sensortec",
  "device_address": 118,
  "registers": [
    "id",
    "ctrl_hum",
    "ctrl_meas"
  ],
  "rule_ids": {
    "ctrl_hum->ctrl_meas": "humidity_latch"
  },
  "scope_description": "Automatically extracted post-startup humidity configuration slice; board address and sleep-only boundary are explicit review inputs.",
  "unsupported": [
    "startup and reset timing",
    "measurement and compensation",
    "forced and normal mode",
    "SPI and multi-byte transfers",
    "unknown registers and reserved-bit changes"
  ],
  "field_constraints": [
    {
      "register": "ctrl_meas",
      "field": "mode",
      "equals": 0,
      "reason": "Measurement modes are outside this reviewed sleep-only extraction slice"
    }
  ]
}
