{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghostchip.local/schema/repair-request-v1.schema.json",
  "title": "GhostChip bounded repair request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "request", "run", "failure", "rule", "source", "identities", "constraints"],
  "properties": {
    "version": {"const": "1.0.0"},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repair_id", "run_id"],
      "properties": {
        "id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "repair_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "run_id": {"type": "string", "minLength": 1}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "case_id", "status", "result_sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "case_id": {"const": "buggy_driver"},
        "status": {"const": "FAIL"},
        "result_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion_ids", "expected", "observed", "summary", "scenario_intent", "trace"],
      "properties": {
        "assertion_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "expected": {},
        "observed": {},
        "summary": {"type": "string", "minLength": 1},
        "scenario_intent": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "trace": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object"}}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "on", "effects", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"const": "accepted"},
        "on": {"type": "object"},
        "effects": {"type": "array", "minItems": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "pdf_page", "section", "summary", "origin"],
            "properties": {
              "id": {"type": "string"},
              "pdf_page": {"type": "integer", "minimum": 1},
              "printed_page": {"type": ["string", "integer"]},
              "section": {"type": "string"},
              "summary": {"type": "string"},
              "origin": {"type": "string"}
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "start_line", "end_line", "content"],
      "properties": {
        "path": {"const": "examples/bme280_buggy.c"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "content": {"type": "string", "minLength": 1, "maxLength": 12000}
      }
    },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewed_bundle", "spec_sha256", "scenario_sha256", "instance_sha256", "fault_plan_sha256", "compiler_configuration", "execution_closure"],
      "properties": {
        "reviewed_bundle": {"type": "object", "minProperties": 1},
        "spec_sha256": {"$ref": "#/$defs/sha256"},
        "scenario_sha256": {"$ref": "#/$defs/sha256"},
        "instance_sha256": {"type": ["string", "null"]},
        "fault_plan_sha256": {"type": ["string", "null"]},
        "compiler_configuration": {"type": "object", "minProperties": 1},
        "execution_closure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "files", "compiler", "sha256"],
          "properties": {
            "version": {"const": "execution-closure-v1"},
            "files": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha256"}},
            "compiler": {"type": "object", "minProperties": 4},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_files", "forbidden_paths", "max_changed_lines", "max_patch_bytes"],
      "properties": {
        "allowed_files": {"const": ["examples/bme280_buggy.c"]},
        "forbidden_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "max_changed_lines": {"type": "integer", "minimum": 1, "maximum": 12},
        "max_patch_bytes": {"type": "integer", "minimum": 256, "maximum": 8192}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
