{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:ghostchip:real-driver-scenario:1",
  "type":"object","additionalProperties":false,
  "properties":{
    "schema_version":{"const":"real-driver-scenario-v1"},
    "id":{"type":"string","pattern":"^[a-z][a-z0-9_]*$"},
    "action":{"enum":["init","configure","reset"]},
    "initial":{"type":"array","maxItems":16,"items":{
      "type":"object","additionalProperties":false,
      "properties":{
        "ref":{"$ref":"#/$defs/ref"},
        "value":{"type":"integer","minimum":0,"maximum":255},
        "basis":{"type":"string","minLength":1,"maxLength":1000}
      },"required":["ref","value","basis"]
    }},
    "required_observations":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z][a-z0-9_.]*$"}},
    "assertions":{"type":"array","minItems":1,"maxItems":64,"items":{
      "type":"object","additionalProperties":false,
      "properties":{
        "id":{"type":"string","pattern":"^[a-z][a-z0-9_]*$"},
        "source":{"enum":["observation","model"]},
        "observation":{"type":"string","pattern":"^[a-z][a-z0-9_.]*$"},
        "ref":{"$ref":"#/$defs/ref"},
        "equals":{"type":"integer","minimum":-32768,"maximum":65535},
        "basis":{"type":"string","minLength":1,"maxLength":1000}
      },"required":["id","source","equals","basis"],
      "allOf":[
        {"if":{"properties":{"source":{"const":"observation"}}},"then":{"required":["observation"],"not":{"required":["ref"]}}},
        {"if":{"properties":{"source":{"const":"model"}}},"then":{"required":["ref"],"not":{"required":["observation"]}}}
      ]
    }},
    "expected_callbacks":{"type":"array","maxItems":32,"items":{
      "type":"object","additionalProperties":false,
      "properties":{
        "operation":{"enum":["read","write","delay"]},
        "register_address":{"type":"integer","minimum":0,"maximum":255},
        "length":{"type":"integer","minimum":1,"maximum":32},
        "duration_us":{"type":"integer","minimum":0,"maximum":1000000},
        "status":{"type":"integer","minimum":-128,"maximum":0}
      },"required":["operation","status"]
    }},
    "expected_faults":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[a-z][a-z0-9_]*$"}}
  },
  "required":["schema_version","id","action","initial","required_observations","assertions","expected_callbacks","expected_faults"],
  "$defs":{
    "ref":{"oneOf":[
      {"type":"object","additionalProperties":false,"properties":{"kind":{"const":"state"},"id":{"type":"string","pattern":"^[a-z][a-z0-9_]*$"}},"required":["kind","id"]},
      {"type":"object","additionalProperties":false,"properties":{"kind":{"const":"field"},"register":{"type":"string","pattern":"^[a-z][a-z0-9_]*$"},"field":{"type":"string","pattern":"^[a-z][a-z0-9_]*$"}},"required":["kind","register","field"]}
    ]}
  }
}
